# Ignore everything by default.
**

# Keep core repo files.
!/.gitignore
!/.github/
!/.github/**

# Keep repo definition YAMLs (public only; private YAMLs live in S3).
!/terraform/
!/terraform/public/
!/terraform/public/**
!/terraform/private/
!/terraform/private/.gitkeep

# Keep runner-level framework overrides (org settings + non-sensitive vars).
# Non-sensitive only: the billing email is delivered via the ORG_BILLING_EMAIL secret.
!/terraform/org.auto.tfvars
